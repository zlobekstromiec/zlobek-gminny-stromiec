# Secrets / local env — NEVER commit
.envrc
.env
.env.*
!.env.example
!.env.test
.dev.vars
.wrangler/

# Key material — this repository is PUBLIC.
# The GitHub App private key (phase 04.1, D-08) lives outside the working tree and
# reaches production only as the GITHUB_APP_PRIVATE_KEY Cloudflare Pages secret.
# These rules are structural insurance against an accidental `git add -A`.
*.pem
*.key
*.p8
*.pkcs8

# Local tool cache (not part of the project)
.ckb/

# Dependencies
node_modules

# SvelteKit / build output
/.svelte-kit
/build
.output
.vercel
.netlify

# Generated Cloudflare types are committed (needed by `wrangler types --check`)

# OS
.DS_Store
Thumbs.db

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright
/test-results
/playwright-report
/playwright/.cache

# GSD research fetch cache (local only)
.planning/research/.cache/

# GSD dispatch runtime state (local only, written by the harness per task)
/.gsd/

# Client-supplied originals staged for import (resized copies live in src/lib/assets/uploads/)
/pictures/
